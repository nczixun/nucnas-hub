{{- $pages := slice -}}
{{- range .Site.RegularPages -}}
{{- if and (not .Params.noindex) (or .Params.searchable (in (slice "hardware" "nas" "ai" "openclaw" "calculator") .Section)) -}}
{{- $pages = $pages | append (dict "title" .Title "url" .RelPermalink "summary" (.Summary | plainify | truncate 180) "text" (.Plain | truncate 12000) "section" .Section) -}}
{{- end -}}
{{- end -}}
{{- $pages | jsonify -}}
